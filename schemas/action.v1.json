{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investigator.local/schemas/action.v1.json",
  "title": "Action",
  "description": "One step in the closed action vocabulary the deterministic interpreter can execute. There is no action type that permits arbitrary script, shell, or model-supplied source. Adding a type requires a schema change and a human gate.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "actionId",
    "type"
  ],
  "properties": {
    "actionId": {
      "$ref": "common.v1.json#/$defs/actionId"
    },
    "type": {
      "enum": [
        "goto",
        "click",
        "dblclick",
        "fill",
        "select",
        "check",
        "uncheck",
        "press",
        "hover",
        "scroll",
        "waitFor",
        "waitForTimeout",
        "assert",
        "screenshot",
        "setStorage",
        "clearStorage",
        "setEmulation",
        "reload",
        "goBack",
        "goForward"
      ]
    },
    "description": {
      "type": "string"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "sideEffect": {
      "$ref": "common.v1.json#/$defs/sideEffectClass",
      "description": "Declared class. The deterministic classifier computes the authoritative value; a declared class weaker than the computed one fails validation."
    },
    "computedSideEffect": {
      "$ref": "common.v1.json#/$defs/sideEffectClass"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "goto"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri-reference",
            "description": "Absolute, or relative to the target baseUrl -- the executor resolves it with `new URL(action.url, target.baseUrl)`, so a target-relative path like `/search` is the normal form and keeps an experiment portable across environments. Either way the RESOLVED origin must be present in safety.allowedOrigins, which is validated outside JSON Schema against the resolved config (enqueueExperiment)."
          },
          "waitUntil": {
            "enum": [
              "commit",
              "domcontentloaded",
              "load",
              "networkidle"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "click",
              "dblclick",
              "check",
              "uncheck",
              "hover"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "selector"
        ],
        "properties": {
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "fill"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "selector",
          "value"
        ],
        "properties": {
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          },
          "value": {
            "$ref": "#/$defs/testDataValue"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "select"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "selector",
          "option"
        ],
        "properties": {
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          },
          "option": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "press"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "key"
        ],
        "properties": {
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "scroll"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          },
          "deltaY": {
            "type": "integer"
          },
          "deltaX": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "waitFor"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "condition"
        ],
        "properties": {
          "condition": {
            "enum": [
              "commit",
              "domcontentloaded",
              "load",
              "networkidle",
              "selectorVisible",
              "selectorHidden",
              "selectorAttached",
              "selectorDetached"
            ]
          },
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "waitForTimeout"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "ms"
        ],
        "properties": {
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000,
            "description": "A fixed delay is a declared timing factor, not a stabilisation hack. It is recorded in the manifest as such."
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "assert"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "assertion"
        ],
        "properties": {
          "assertion": {
            "$ref": "#/$defs/assertion"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "screenshot"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "selector": {
            "$ref": "common.v1.json#/$defs/selector"
          },
          "fullPage": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "setStorage"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "area",
          "key",
          "value"
        ],
        "properties": {
          "area": {
            "enum": [
              "localStorage",
              "sessionStorage"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "$ref": "#/$defs/testDataValue"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "clearStorage"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "areas": {
            "type": "array",
            "items": {
              "enum": [
                "localStorage",
                "sessionStorage",
                "cookies",
                "indexedDb",
                "cache"
              ]
            }
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "setEmulation"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "profileName"
        ],
        "properties": {
          "profileName": {
            "type": "string",
            "description": "Mid-run emulation change. Declared as the varied factor and recorded; comparisons across it are refused unless declared."
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "testDataValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "literal"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "literal": {
              "type": "string",
              "description": "Rejected by the validator when it matches a credential, real-domain email, card, or phone shape. The model may not invent test data."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "generator"
          ],
          "properties": {
            "kind": {
              "const": "generated"
            },
            "generator": {
              "enum": [
                "seededEmail",
                "seededUsername",
                "seededNumber",
                "seededUuid",
                "seededString"
              ]
            },
            "params": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "envVar"
          ],
          "properties": {
            "kind": {
              "const": "secretRef"
            },
            "envVar": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Environment variable NAME only. The value is resolved at run time through SecretStore and never persisted."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "unknownId"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "unknownId": {
              "type": "string",
              "description": "References a Flow unknown the human must fill. Enqueue is refused while any unknown remains unresolved."
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "assertionId",
        "kind"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "pattern": "^AS[0-9]{1,4}$"
        },
        "kind": {
          "enum": [
            "elementCountAtLeast",
            "elementCountEquals",
            "elementVisible",
            "elementHidden",
            "textContains",
            "textEquals",
            "attributeEquals",
            "urlMatches",
            "noConsoleErrors",
            "noUncaughtExceptions",
            "responseStatusIn",
            "storageKeyPresent",
            "storageKeyAbsent"
          ]
        },
        "selector": {
          "$ref": "common.v1.json#/$defs/selector"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "attribute": {
          "type": "string"
        },
        "expected": {
          "$ref": "common.v1.json#/$defs/jsonPrimitive"
        },
        "urlPattern": {
          "type": "string"
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "storageArea": {
          "enum": [
            "localStorage",
            "sessionStorage"
          ]
        },
        "storageKey": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "isFailurePredicate": {
          "type": "boolean",
          "description": "When true, a match indicates the product failure rather than a violated expectation. Feeds RunOutcome rule 4."
        }
      }
    }
  }
}
