{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investigator.local/schemas/finding.v1.json",
  "title": "Finding",
  "description": "One analytical claim with explicit, validated evidence references. Levels are the canonical ladder only. The display label correlated_difference maps to correlated in the renderer and is not accepted here. confirmed_root_cause requires an approved direct_evidence_attestation, which the MVP has no command to mint, so it is unreachable by design.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findingId", "investigationId", "level", "statement",
               "supportingEvidence", "contradictingEvidence", "confidence"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "findingId": { "$ref": "common.v1.json#/$defs/findingId" },
    "investigationId": { "$ref": "common.v1.json#/$defs/investigationId" },
    "level": { "$ref": "common.v1.json#/$defs/findingLevel" },
    "statement": { "type": "string", "minLength": 10 },
    "claimCategory": {
      "description": "Selects the allowed artifact kinds for reference check 5.",
      "enum": ["network-timing", "network-status", "console", "exception", "dom-state",
               "storage-state", "navigation", "visual", "frequency-statistic",
               "reproduction-behaviour", "mechanism"]
    },
    "mechanism": {
      "type": "string",
      "description": "Required at root_cause_hypothesis and above: the proposed mechanism that would explain the trigger."
    },
    "supportingEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "contradictingEvidence": {
      "type": "array",
      "description": "Required to be present, possibly empty. Validated identically to supporting evidence.",
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "contradictionResolution": {
      "type": "string",
      "description": "Required to hold high_confidence_trigger or above when contradictingEvidence is non-empty; otherwise the finding is demoted one level. Rendered verbatim."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Recorded and displayed. Never used as a gate. Values above 0.95 are rejected at correlated or below as internally inconsistent."
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceCheckPassed"],
      "properties": {
        "referenceCheckPassed": { "type": "boolean" },
        "requestedLevel": {
          "$ref": "common.v1.json#/$defs/findingLevel",
          "description": "The level the model asked for, when it differs from the persisted level."
        },
        "demotions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "reason"],
            "properties": {
              "from": { "$ref": "common.v1.json#/$defs/findingLevel" },
              "to": { "$ref": "common.v1.json#/$defs/findingLevel" },
              "reason": {
                "enum": ["INSUFFICIENT_RUNS", "OVERLAPPING_INTERVALS", "NO_MATCHED_CONTROL",
                         "NO_APPROVED_REPRODUCTION", "INCOMPLETE_EVIDENCE_CATEGORY",
                         "UNRESOLVED_CONTRADICTION", "MISSING_FIELD_CITATION"]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "capReason": {
          "type": ["string", "null"],
          "description": "Set when a non-complete evidence category capped the level at correlated."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKind"],
      "properties": {
        "actorKind": { "$ref": "common.v1.json#/$defs/actorKind" },
        "aiCallId": { "$ref": "common.v1.json#/$defs/aiCallId" },
        "flowArtifactId": { "type": "string" },
        "flowArtifactVersion": { "$ref": "common.v1.json#/$defs/semver" },
        "flowHash": { "$ref": "common.v1.json#/$defs/sha256" },
        "createdAt": { "$ref": "common.v1.json#/$defs/timestamp" }
      }
    }
  },
  "allOf": [
    {
      "description": "Causal-flavoured claims require at least one exact field and value citation. A purely existential citation is insufficient.",
      "if": {
        "properties": {
          "level": {
            "enum": ["probable_trigger", "high_confidence_trigger", "confirmed_trigger",
                     "root_cause_hypothesis", "confirmed_root_cause"]
          }
        },
        "required": ["level"]
      },
      "then": {
        "properties": {
          "supportingEvidence": {
            "contains": { "required": ["field", "expectedValue"] }
          }
        }
      }
    },
    {
      "description": "A proposed mechanism is required once the claim reaches hypothesis territory.",
      "if": {
        "properties": { "level": { "enum": ["root_cause_hypothesis", "confirmed_root_cause"] } },
        "required": ["level"]
      },
      "then": { "required": ["mechanism"] }
    },
    {
      "description": "confirmed_root_cause requires an approved direct evidence attestation. Hard fail otherwise.",
      "if": {
        "properties": { "level": { "const": "confirmed_root_cause" } },
        "required": ["level"]
      },
      "then": {
        "properties": {
          "supportingEvidence": {
            "contains": {
              "allOf": [
                { "properties": { "kind": { "const": "directEvidence" } }, "required": ["kind"] },
                { "required": ["approvalId", "artifactIds"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["event", "artifact", "statistic", "comparison", "approval", "directEvidence"]
        },
        "field": {
          "$ref": "common.v1.json#/$defs/jsonPointer",
          "description": "JSON Pointer into the normalized event or statistic payload. Must resolve."
        },
        "expectedValue": {
          "$ref": "common.v1.json#/$defs/jsonPrimitive",
          "description": "Compared by strict deep equality against the actual stored value. No coercion, no tolerance."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "event" } }, "required": ["kind"] },
          "then": {
            "required": ["runId", "eventIds"],
            "properties": {
              "runId": { "$ref": "common.v1.json#/$defs/runId" },
              "eventIds": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.v1.json#/$defs/eventId" }
              },
              "artifactIds": {
                "type": "array",
                "items": { "$ref": "common.v1.json#/$defs/artifactId" }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] },
          "then": {
            "required": ["runId", "artifactIds"],
            "properties": {
              "runId": { "$ref": "common.v1.json#/$defs/runId" },
              "artifactIds": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.v1.json#/$defs/artifactId" }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "statistic" } }, "required": ["kind"] },
          "then": {
            "required": ["investigationId", "statisticId"],
            "properties": {
              "investigationId": { "$ref": "common.v1.json#/$defs/investigationId" },
              "statisticId": { "$ref": "common.v1.json#/$defs/statisticId" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "comparison" } }, "required": ["kind"] },
          "then": {
            "required": ["comparisonId", "runIdsA", "runIdsB"],
            "properties": {
              "comparisonId": { "$ref": "common.v1.json#/$defs/comparisonId" },
              "runIdsA": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.v1.json#/$defs/runId" }
              },
              "runIdsB": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.v1.json#/$defs/runId" }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "approval" } }, "required": ["kind"] },
          "then": {
            "required": ["approvalId"],
            "properties": { "approvalId": { "$ref": "common.v1.json#/$defs/approvalId" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "directEvidence" } }, "required": ["kind"] },
          "then": {
            "required": ["artifactIds", "approvalId"],
            "properties": {
              "artifactIds": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.v1.json#/$defs/artifactId" }
              },
              "approvalId": {
                "$ref": "common.v1.json#/$defs/approvalId",
                "description": "Must resolve to an ApprovalRecord of type direct_evidence_attestation, checksum-bound to the referenced artifact."
              }
            }
          }
        }
      ]
    }
  }
}
