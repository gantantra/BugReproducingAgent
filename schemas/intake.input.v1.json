{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investigator.local/schemas/intake.input.v1.json",
  "title": "intake_to_flow input",
  "description": "Input to the intake_to_flow flow. The report body is untrusted human prose and is presented as data, never as instructions. The closed action vocabulary and the resolved constraints are supplied so the flow cannot propose an action type or an origin that does not exist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "investigationId", "report", "constraints", "actionVocabulary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "investigationId": { "$ref": "common.v1.json#/$defs/investigationId" },
    "report": { "$ref": "intake-report.v1.json" },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetName", "baseUrl", "classification", "allowedOrigins",
                   "permittedActionTypes", "destructivePolicy"],
      "properties": {
        "targetName": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "classification": { "$ref": "common.v1.json#/$defs/targetClassification" },
        "allowedOrigins": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "permittedActionTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "destructivePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocked"],
          "properties": {
            "blocked": { "type": "boolean" },
            "note": { "type": "string" }
          }
        },
        "resetStrategy": { "type": "string" },
        "emulationProfiles": { "type": "array", "items": { "type": "string" } },
        "defaultEmulationProfile": { "type": ["string", "null"] },
        "declaredTestDataGenerators": { "type": "array", "items": { "type": "string" } },
        "declaredCredentialEnvVarNames": {
          "type": "array",
          "description": "Names only. The flow may reference a name; it may never invent a credential value.",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "actionVocabulary": {
      "type": "array",
      "minItems": 1,
      "description": "The closed set of executable action types with their required fields. The flow may not emit anything outside it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "requiredFields", "sideEffect"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "requiredFields": { "type": "array", "items": { "type": "string" } },
          "sideEffect": { "$ref": "common.v1.json#/$defs/sideEffectClass" },
          "description": { "type": "string" }
        }
      }
    },
    "assertionVocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "requiredFields"],
        "properties": {
          "kind": { "type": "string" },
          "requiredFields": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "priorFlow": {
      "anyOf": [{ "$ref": "flow.v1.json" }, { "type": "null" }],
      "description": "Present on a refresh so the flow can preserve human-resolved unknowns and prior edits."
    }
  }
}
