{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investigator.local/schemas/flow.v1.json",
  "title": "Flow",
  "description": "The structured interpretation of a human-reported issue. Produced by intake_to_flow, edited by a human, and the input to propose_experiments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "flowId", "investigationId", "title", "steps", "assumptions", "unknowns"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "flowId": { "type": "string", "pattern": "^FLOW-[0-9]{3,}$" },
    "investigationId": { "$ref": "common.v1.json#/$defs/investigationId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "targetName": {
      "type": "string",
      "description": "Named target from config.execution.targets. Must exist; the flow may not introduce a target."
    },
    "reportedFrequency": {
      "type": ["string", "null"],
      "description": "Verbatim or lightly normalized from the human report, for example one in twenty. Never converted into a numeric rate: that is measured, not reported."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "description", "actions"],
        "properties": {
          "stepId": { "type": "string", "pattern": "^S[0-9]{1,3}$" },
          "description": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "array",
            "minItems": 0,
            "items": { "$ref": "action.v1.json" }
          },
          "sourceQuote": {
            "type": "string",
            "description": "The span of the human report this step was derived from. Grounds the interpretation."
          }
        }
      }
    },
    "expectedBehaviour": { "type": "string" },
    "observedBehaviour": { "type": "string" },
    "assumptions": {
      "type": "array",
      "description": "Interpretations the flow made that the report did not state. Required so the human can correct them at gate 1.",
      "items": { "type": "string", "minLength": 1 }
    },
    "unknowns": {
      "type": "array",
      "description": "Values the flow could not ground. The model must emit these rather than inventing. Enqueue is refused while any remains unresolved.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "field", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^U[0-9]{1,3}$" },
          "field": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "resolvedValue": { "$ref": "common.v1.json#/$defs/jsonPrimitive" },
          "resolvedBy": { "$ref": "common.v1.json#/$defs/approvalId" },
          "resolvedAt": { "$ref": "common.v1.json#/$defs/timestamp" }
        }
      }
    },
    "emulationProfile": {
      "type": "string",
      "description": "Named profile from config. Resolved values are recorded per run, not here."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKind"],
      "properties": {
        "actorKind": { "$ref": "common.v1.json#/$defs/actorKind" },
        "aiCallId": { "$ref": "common.v1.json#/$defs/aiCallId" },
        "flowArtifactId": { "type": "string" },
        "flowArtifactVersion": { "$ref": "common.v1.json#/$defs/semver" },
        "flowHash": { "$ref": "common.v1.json#/$defs/sha256" },
        "intakeReportArtifactId": { "$ref": "common.v1.json#/$defs/artifactId" },
        "createdAt": { "$ref": "common.v1.json#/$defs/timestamp" }
      }
    }
  }
}
