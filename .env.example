# ReproAgent — DeepSeek configuration.
#
# Copy to `.env` (gitignored) and fill in. Nothing here is needed for the deterministic path:
# `init`, `run`, `doctor`, `suite generate` and the whole approval workflow never read it.
# Only `intake --ai` and `plan --ai` do, and they resolve it at the point of use.
#
# The real environment always wins over this file, so an `export` in your shell overrides it.
# Set REPROAGENT_NO_ENV_FILE=1 to ignore this file entirely.
#
# The key is read from the environment only. It is never logged, persisted, written to an
# artifact, or included in an error message.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model IDs are never guessed and never substituted. Use the exact ids your DeepSeek
# account exposes.
DEEPSEEK_FAST_MODEL=
DEEPSEEK_REASONING_MODEL=
DEEPSEEK_FALLBACK_MODEL=
